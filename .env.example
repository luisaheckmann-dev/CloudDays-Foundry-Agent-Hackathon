# Copy to .env; never commit actual endpoints or credentials.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_DEPLOYMENT_NAME=YOUR-DEPLOYMENT-NAME
FOUNDRY_AGENT_NAME=orderops-YOUR-TEAM
# AzureCliCredential deliberately uses your explicit az login, no credential fallback.
# Use only your approved customer project, deployment and own Entra sign-in.
# Optional: restrict the credential to your customer's approved tenant.
# Optional: choose ONE selector, not both. Subscription is exact for multiple CLI accounts.
# Verify the actual project subscription too; a matching tenant alone is insufficient.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
